{
  "name": "garage",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "DATABASE_PATH=${DATABASE_PATH:-data/garage.db} vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "backup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/backup.ts",
    "import": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/import.ts",
    "staff": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/staff.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@vercel/blob": "^2.9.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@pandacss/vite": "^2.5.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "nitro": "^3.0.261103-rc",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
